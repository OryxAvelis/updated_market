{
  "name": "am-market-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secure MySQL-backed API and HTTPS server for the AM MARKET storefront.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "node scripts/check-source.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "mysql2": "3.23.4",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  }
}
