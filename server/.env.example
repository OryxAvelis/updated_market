# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
HTTPS_PORT=3443
APP_ORIGIN=https://localhost:3443
ALLOWED_ORIGINS=https://localhost:3443
TRUST_PROXY=0
TLS_TERMINATED_BY_PROXY=false
LOG_LEVEL=info

# HTTPS. Keep real certificates and private keys outside Git.
TLS_CERT_PATH=./certs/localhost.pem
TLS_KEY_PATH=./certs/localhost-key.pem
HTTP_REDIRECT_PORT=3000

# MySQL. Use a dedicated, least-privilege application account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=am_market
DB_USER=am_market_app
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECTION_LIMIT=10
DB_TLS=true
DB_TLS_CA_PATH=./certs/mysql-ca.pem
DB_TLS_SERVERNAME=localhost

# Authentication
SESSION_COOKIE_NAME=__Host-am_session
SESSION_TTL_DAYS=30
SESSION_IDLE_HOURS=24
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RESET_URL=https://localhost:3443/reset-password.html

# Product source of truth already used by the storefront
CATALOG_API_ORIGIN=https://api.mmarket.ma
CATALOG_API_BASE_URL=https://api.mmarket.ma/api
CATALOG_TIMEOUT_MS=8000
CATALOG_CACHE_TTL_MS=60000

# Low-stock evaluator. Values are deliberately bounded by server validation.
LOW_STOCK_EVALUATOR_ENABLED=true
LOW_STOCK_EVALUATOR_INTERVAL_MS=300000
LOW_STOCK_EVALUATOR_RUN_TIMEOUT_MS=25000
LOW_STOCK_EVALUATOR_BATCH_SIZE=100
LOW_STOCK_EVALUATOR_CONCURRENCY=4
LOW_STOCK_DEFAULT_THRESHOLD=5
LOW_STOCK_NOTIFICATION_TTL_DAYS=30

# SMTP is required for password-reset delivery outside test environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AM MARKET <no-reply@example.com>

# Fulfillment webhook. In production, prefer the *_FILE option with a secret
# mounted from the deployment secret manager. Configure exactly one source.
FULFILLMENT_WEBHOOK_SECRET=
FULFILLMENT_WEBHOOK_SECRET_FILE=
FULFILLMENT_WEBHOOK_TOLERANCE_SECONDS=300
